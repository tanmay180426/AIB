# Test-only runtime: never used by the target API or to retrain a model.
FROM python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f
RUN pip install --no-cache-dir numpy==2.1.3 pandas==2.2.3 joblib==1.4.2 scikit-learn==1.6.1
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
ENTRYPOINT ["python", "-I", "/audit/abi_candidate_smoke.py"]
